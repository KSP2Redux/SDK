<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <!--
        The ocean's renderer assets and the material's generated textures, wired by OceanSection. ocean-assets and
        ocean-quality bind to the PQS renderer rather than the PQS or the body.
    -->

    <engine:Label name="ocean-hint" class="sdk-hint" />
    <engine:VisualElement name="ocean-assets">
        <editor:PropertyField binding-path="_oceanSpectrum" label="Wave Spectrum" tooltip="The wave spectrum the ocean animates from. Add Ocean creates one from a stock body's." />
        <editor:PropertyField binding-path="OceanWaterMaterial" label="Water Material" tooltip="The water material, on the SDK's ocean stand-in shader. The renderer draws with a copy on the game's ocean shader." />
    </engine:VisualElement>
    <engine:Foldout name="ocean-spectrum" text="Wave Spectrum" value="false" class="sdk-subsection-foldout">
        <engine:VisualElement name="ocean-spectrum-inline" />
    </engine:Foldout>
    <engine:Foldout name="ocean-material" text="Water Material" value="false" class="sdk-subsection-foldout">
        <engine:VisualElement name="ocean-material-inline" />
    </engine:Foldout>
    <engine:Foldout name="ocean-textures" text="Generated Textures" value="true" class="sdk-subsection-foldout" tooltip="Caustics, foam shapes and normal maps generated from tiling noise and saved beside the material. Stock's are in the game's bundles, where a project material cannot reference them.">
        <engine:VisualElement name="ocean-texture-settings" />
        <engine:Label name="ocean-shoreline-status" class="sdk-hint" />
        <engine:Button name="ocean-generate-shoreline" text="Generate Shoreline" tooltip="Make the shoreline mask the ocean calms its waves near the coast with: the global heightmap against sea level, sea white and land black, as stock's are. Regenerate it after changing the terrain or Ocean Altitude." class="sdk-action-button" />
        <engine:Button name="ocean-generate-all" text="Generate All Textures" tooltip="Generate every texture from its settings and the shoreline from the terrain, save them beside the material and assign them." class="sdk-action-button" />
        <engine:Label name="ocean-textures-status" class="sdk-hint" />
    </engine:Foldout>
    <engine:Foldout name="ocean-quality" text="Lava and quality" value="false" class="sdk-subsection-foldout">
        <editor:PropertyField binding-path="OceanLavaMaterial" label="Lava Material" tooltip="A lava material, drawn instead of water when the body has no water material." />
        <editor:PropertyField binding-path="OceanFeaure_LowQuality" label="Low Quality" tooltip="The features drawn at the player&apos;s Low water quality setting." />
        <editor:PropertyField binding-path="OceanFeaure_MediumQuality" label="Medium Quality" tooltip="The features drawn at the player&apos;s Medium water quality setting." />
        <editor:PropertyField binding-path="OceanFeaure_HighQuality" label="High Quality" tooltip="The features drawn at the player&apos;s High water quality setting." />
        <editor:PropertyField binding-path="OceanColliderIsTrigger" label="Collider Is Trigger" tooltip="Make the ocean collider a convex trigger, which reports overlaps without blocking anything." />
    </engine:Foldout>

</engine:UXML>
