.property-fields-row {
    flex-direction: row;
}

/* ===== Vector4Channels ===== */

.vec4-channels-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 50px;
    margin-left: 0;
    margin-right: 2px;
}

.vec4-channels-field > .unity-base-field__label {
    min-width: 28px;
    flex-basis: 28px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-self: center;
    -unity-text-align: middle-center;
}

.vec4-channels-field > .unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

/* ===== FadeCurveField (inline preview) ===== */

.fade-curve-preview {
    flex-direction: row;
    align-items: center;
    height: 18px;
    padding-left: 0;
    padding-right: 4px;
}

.fade-curve-thumbnail {
    width: 60px;
    height: 16px;
    margin-left: 1px;
    margin-right: 4px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.fade-curve-summary {
    flex-grow: 1;
    -unity-text-align: middle-left;
    font-size: 11px;
}

/* ===== ScatterStratumField (stratum picker) ===== */

.scatter-stratum-input {
    flex-direction: row;
    align-items: center;
    height: 18px;
    padding-left: 0;
    padding-right: 0;
}

.scatter-stratum-swatch {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 4px;
    background-color: rgba(20, 22, 28, 0.6);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    -unity-background-scale-mode: scale-and-crop;
}

.scatter-stratum-picker {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
    -unity-text-align: middle-left;
}

.scatter-stratum-raw {
    width: 44px;
    flex-shrink: 0;
    margin-left: 4px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.scatter-stratum-raw > .unity-base-field__input {
    min-width: 0;
}

.scatter-stratum-detail {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: 10px;
    color: rgb(150, 155, 160);
    -unity-text-align: middle-left;
}

.scatter-stratum-detail--warning {
    color: rgb(230, 175, 90);
}

.scatter-stratum-picker--unresolved {
    -unity-font-style: italic;
}

/* ===== ScatterTextureRuleRow ===== */

.scatter-rule-row {
    flex-direction: column;
    margin-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: rgba(40, 45, 55, 0.35);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.scatter-rule-row__line {
    flex-direction: row;
    align-items: center;
}

.scatter-rule-row__stratum {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.scatter-rule-row__remove {
    width: 20px;
    flex-shrink: 0;
    margin-left: 4px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.scatter-rule-row__window-label {
    width: 48px;
    flex-shrink: 0;
    font-size: 11px;
    color: rgb(170, 178, 188);
    -unity-text-align: middle-left;
}

.scatter-rule-row__bound {
    width: 46px;
    flex-shrink: 0;
    margin: 0;
}

.scatter-rule-row__bound > .unity-base-field__input {
    min-width: 0;
}

.scatter-rule-row__slider {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 0;
    margin-bottom: 0;
}

.scatter-rule-row__warning {
    margin-top: 2px;
    font-size: 10px;
    color: rgb(230, 175, 90);
    white-space: normal;
}

/* ===== FadeCurvePopup ===== */

.fade-curve-popup-root {
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
}

.fade-curve-popup-graph {
    height: 160px;
    margin-bottom: 6px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.fade-curve-popup-field {
    margin-top: 1px;
    margin-bottom: 1px;
}

/* ===== SmallLayerMatrix ===== */

.small-layer-matrix {
    flex-direction: column;
}

.small-layer-matrix-row {
    flex-direction: row;
    align-items: stretch;
}

.small-layer-matrix-header-row {
    margin-bottom: 2px;
}

.small-layer-matrix-corner {
    width: 60px;
    flex-shrink: 0;
}

.small-layer-matrix-row-header {
    width: 60px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
    -unity-font-style: bold;
    padding-right: 6px;
}

.small-layer-matrix-col-header {
    flex-grow: 1;
    flex-basis: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-left: 2px;
    margin-right: 2px;
    color: rgb(180, 200, 220);
}

.small-layer-matrix-cell {
    flex-grow: 1;
    flex-basis: 0;
    margin: 2px;
    padding: 4px;
    background-color: rgba(40, 45, 55, 0.5);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.small-layer-matrix-cell:hover {
    background-color: rgba(60, 70, 90, 0.5);
}

.small-layer-matrix-cell--selected {
    border-left-color: rgb(95, 150, 210);
    border-right-color: rgb(95, 150, 210);
    border-top-color: rgb(95, 150, 210);
    border-bottom-color: rgb(95, 150, 210);
    background-color: rgba(70, 100, 140, 0.55);
}

.small-layer-matrix-cell--empty {
    background-color: rgba(30, 30, 35, 0.4);
}

.small-layer-matrix-cell-tex {
    margin-bottom: 2px;
}

.small-layer-matrix-cell-preview {
    width: 100%;
    height: 64px;
    margin-bottom: 4px;
    background-color: rgba(20, 22, 28, 0.6);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    -unity-background-scale-mode: scale-and-crop;
}

.small-layer-matrix-cell-material {
    margin-bottom: 4px;
}

.small-layer-matrix-cell-summary {
    font-size: 10px;
    color: rgb(170, 175, 180);
    -unity-text-align: middle-left;
    white-space: normal;
}

.small-layer-matrix-cell-empty-label {
    font-size: 10px;
    color: rgb(120, 120, 125);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    white-space: normal;
}
