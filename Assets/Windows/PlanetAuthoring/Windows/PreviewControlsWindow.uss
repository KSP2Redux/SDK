/* Preview Controls window — overrides on top of PlanetAuthoring.uss.
 * Only rules unique to this window live here; the shared root/section/field
 * styling is in PlanetAuthoring.uss. */

/* Plain labels sit flush against the section edge while BaseField controls carry Unity's own
 * margin-left, so a section mixing the two has its text starting a few pixels left of its field
 * labels. Match that margin so labels and control labels share a left edge. */

.preview-status {
    white-space: normal;
    margin-bottom: 2px;
    margin-left: 3px;
}

.preview-body {
    margin-bottom: 2px;
    margin-left: 3px;
}

.preview-altitude {
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 6px;
    margin-left: 3px;
}

/* Same treatment for hint text, scoped to this window so hints in other tools are unaffected. */
.preview-root .sdk-hint {
    margin-left: 3px;
}

.preview-jump-stack {
    flex-direction: column;
}
