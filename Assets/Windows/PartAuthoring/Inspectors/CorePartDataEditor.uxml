<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements">

    <engine:VisualElement class="part-inspector-root">

        <engine:VisualElement name="part-inspector-header" class="sdk-inspector-header">

            <engine:VisualElement class="sdk-inspector-identity-row">
                <engine:VisualElement name="header-icon" class="sdk-inspector-icon" />
                <engine:VisualElement class="sdk-inspector-identity-text">
                    <engine:Label name="header-part-name" class="sdk-inspector-name" />
                    <engine:VisualElement class="sdk-inspector-chip-row">
                        <engine:Label name="header-family-chip" class="sdk-inspector-meta-chip" />
                        <engine:Label name="header-size-chip"   class="sdk-inspector-meta-chip" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="sdk-inspector-row">
                <engine:Label text="Readiness" class="sdk-inspector-row-label" />
                <engine:VisualElement class="sdk-inspector-chip-row">
                    <engine:Label name="readiness-chip-json"    class="sdk-readiness-chip" />
                    <engine:Label name="readiness-chip-icon"    class="sdk-readiness-chip" />
                    <engine:Label name="readiness-chip-reentry" class="sdk-readiness-chip" />
                    <engine:Label name="readiness-chip-drag-cubes" class="sdk-readiness-chip" />
                    <engine:Button name="readiness-chip-valid"  class="sdk-readiness-chip" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="sdk-inspector-row">
                <engine:Label text="Quick Tools" class="sdk-inspector-row-label" />
                <engine:VisualElement class="sdk-inspector-chip-row">
                    <engine:Button name="chip-bake-icon"            text="Bake Icon"         class="sdk-tool-chip" />
                    <engine:Button name="chip-bake-reentry"         text="Bake Reentry Mesh" class="sdk-tool-chip" />
                    <engine:Button name="chip-reexport-json"        text="Re-export JSON"    class="sdk-tool-chip" />
                    <engine:Button name="chip-open-prefab"          text="Open Prefab"       class="sdk-tool-chip" />
                    <engine:Button name="chip-open-reference-parts" text="Reference Parts"   class="sdk-tool-chip" tooltip="Open the Reference Parts window, scoped to this part's bucket." />
                    <engine:Button name="chip-export-localizations" text="Export Localizations" class="sdk-tool-chip" tooltip="Export this part's loc keys (incl. variants) to a CSV." />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="sdk-inspector-row">
                <engine:Label text="Gizmos" class="sdk-inspector-row-label" />
                <engine:VisualElement class="sdk-inspector-chip-row">
                    <engine:Button name="gizmo-pill-com"           text="Center of Mass"         class="sdk-pill" />
                    <engine:Button name="gizmo-pill-col"           text="Center of Lift"         class="sdk-pill" />
                    <engine:Button name="gizmo-pill-attach"        text="Attach Nodes"           class="sdk-pill" />
                    <engine:Button name="gizmo-pill-colliders"     text="Colliders"              class="sdk-pill" />
                    <engine:Button name="gizmo-pill-virtual-parts" text="Virtual Attached Parts" class="sdk-pill" />
                    <engine:Button name="gizmo-pill-engine-thrust" text="Engine Thrust"            class="sdk-pill" />
                    <engine:Button name="gizmo-pill-gimbal-cone"   text="Gimbal Range"             class="sdk-pill" />
                    <engine:Button name="gizmo-pill-rcs-thrusters" text="RCS Thrusters"            class="sdk-pill" />
                    <engine:Button name="gizmo-pill-drag-cubes"      text="Drag Cubes"               class="sdk-pill" />
                    <engine:Button name="gizmo-pill-fairing-preview" text="Fairing Preview"          class="sdk-pill" />
                    <engine:Button name="gizmo-pill-lift-arrow"        text="Lift Direction"           class="sdk-pill" />
                    <engine:Button name="gizmo-pill-control-arc"       text="Control Surface Arc"      class="sdk-pill" />
                    <engine:Button name="gizmo-pill-cargo-volume"      text="Cargo Bay Volume"         class="sdk-pill" />
                    <engine:Button name="gizmo-pill-fairing-ejection"  text="Fairing Ejection"         class="sdk-pill" />
                    <engine:Button name="gizmo-pill-decouple-split"    text="Decouple Split"           class="sdk-pill" />
                    <engine:Button name="gizmo-pill-docking-frame"     text="Docking Frame"            class="sdk-pill" />
                    <engine:Button name="gizmo-pill-solar-incidence"   text="Solar Incidence"          class="sdk-pill" />
                    <engine:Button name="gizmo-pill-intake-direction"  text="Intake Direction"         class="sdk-pill" />
                    <engine:Button name="gizmo-pill-radiator-surface"  text="Radiator Surface"         class="sdk-pill" />
                </engine:VisualElement>
            </engine:VisualElement>

        </engine:VisualElement>

        <engine:VisualElement name="part-tab-bar" class="sdk-tab-bar">
            <engine:Button name="tab-core"      text="Core"      class="sdk-tab" />
            <engine:Button name="tab-modules"   text="Modules"   class="sdk-tab" />
            <engine:Button name="tab-variants"  text="Variants"  class="sdk-tab" />
        </engine:VisualElement>

        <engine:VisualElement name="part-tab-content" class="part-tab-content" />

    </engine:VisualElement>

</engine:UXML>
