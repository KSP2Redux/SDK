/* ============================================================================
 * Ksp2UnityToolsStyles.uss
 *
 * Single source of truth for editor inspector + editor window theming across
 * every tool that ships in the KSP2UnityTools SDK package. Loaded into a root
 * VisualElement via Ksp2UnityToolsStyles.Apply; window-specific overrides
 * layer on top in argument order.
 *
 * Currently used by the Planet Authoring tool family (Preview Controls,
 * Celestial Body / PQS / Decal inspectors), and intended to extend to future
 * tools without per-tool style fragmentation.
 *
 * Generic class names use the .sdk- prefix. Existing module-specific class
 * names (.preview-section, .body-inspector-*, .decal-inspector-*,
 * .pqs-inspector-*) are kept as compatibility aliases so adopting the unified
 * sheet doesn't require touching every UXML.
 * ========================================================================== */

/* ----- Roots ------------------------------------------------------------ */

.sdk-root,
.preview-root,
.body-inspector-root,
.decal-controller-root,
.decal-inspector-root,
.pqs-inspector-root {
    padding-left: 4px;
    padding-right: 4px;
}

.preview-root {
    padding-top: 6px;
    padding-bottom: 6px;
}

/* ----- Standalone section header (non-foldout) -------------------------- */

.sdk-section-header {
    -unity-font-style: bold;
    color: rgb(245, 248, 255);
    background-color: rgba(70, 100, 140, 0.45);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 6px;
    padding-right: 6px;
    margin-bottom: 6px;
}

/* ----- Section foldout chrome ------------------------------------------- */

.sdk-section > .unity-foldout__toggle,
.preview-section > .unity-foldout__toggle,
.body-inspector-section > .unity-foldout__toggle,
.decal-controller-section > .unity-foldout__toggle,
.decal-inspector-section > .unity-foldout__toggle,
.pqs-inspector-section > .unity-foldout__toggle {
    background-color: rgba(70, 100, 140, 0.45);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 0;
    padding-right: 4px;
    margin-top: 4px;
    margin-left: 0;
}

.sdk-section > .unity-foldout__toggle Label,
.preview-section > .unity-foldout__toggle Label,
.body-inspector-section > .unity-foldout__toggle Label,
.decal-controller-section > .unity-foldout__toggle Label,
.decal-inspector-section > .unity-foldout__toggle Label,
.pqs-inspector-section > .unity-foldout__toggle Label {
    -unity-font-style: bold;
}

.sdk-section > .unity-foldout__content,
.preview-section > .unity-foldout__content,
.body-inspector-section > .unity-foldout__content,
.decal-controller-section > .unity-foldout__content,
.decal-inspector-section > .unity-foldout__content,
.pqs-inspector-section > .unity-foldout__content {
    padding-left: 8px;
    padding-right: 4px;
    padding-top: 6px;
    padding-bottom: 4px;
}

.sdk-section .unity-decorator-drawers-container,
.body-inspector-section .unity-decorator-drawers-container,
.pqs-inspector-section .unity-decorator-drawers-container {
    display: none;
}

/* Section content sits flush with the toggle (no Unity-default indent). */
.sdk-section > .unity-foldout__content {
    margin-left: 0;
}

/* Vertical-scope modifier -- compose with .sdk-section to wrap the section's
 * content area in a bordered card, mirroring IMGUI's
 * EditorGUILayout.VerticalScope(EditorStyles.helpBox). */

.sdk-section-vertical-scope > .unity-foldout__content,
.attach-nodes-container {
    background-color: rgba(255, 255, 255, 0.04);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.45);
    border-right-color: rgba(0, 0, 0, 0.45);
    border-top-color: rgba(0, 0, 0, 0.45);
    border-bottom-color: rgba(0, 0, 0, 0.45);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    margin-top: 2px;
}


/* ----- Sub-section foldout (nested, lighter chrome) --------------------- */

.sdk-subsection,
.pqs-inspector-subsection {
    margin-left: -8px;
    margin-right: -4px;
}

.sdk-subsection-inset {
    margin-left: 4px;
    margin-top: 2px;
}

.sdk-subsection > .unity-foldout__toggle,
.pqs-inspector-subsection > .unity-foldout__toggle,
.sdk-subsection-inset > .unity-foldout__toggle {
    background-color: rgba(70, 100, 140, 0.25);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
    margin-top: 3px;
}

.sdk-subsection > .unity-foldout__toggle Label,
.pqs-inspector-subsection > .unity-foldout__toggle Label,
.sdk-subsection-inset > .unity-foldout__toggle Label {
    -unity-font-style: bold;
}

.sdk-subsection > .unity-foldout__content,
.pqs-inspector-subsection > .unity-foldout__content,
.sdk-subsection-inset > .unity-foldout__content {
    margin-left: 0;
    padding-left: 8px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
}

/* ----- Form fields ------------------------------------------------------ */

.sdk-field,
.preview-coord-field,
.decal-inspector-field {
    margin-bottom: 2px;
}

/* ----- Override rows (toggle + field, horizontal) ---------------------- */

.decal-inspector-override-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.decal-inspector-override-toggle {
    margin-right: 4px;
    flex-shrink: 0;
}

.decal-inspector-override-field {
    flex-grow: 1;
}

/* ----- Button rows ------------------------------------------------------ */

.sdk-button-row,
.preview-button-row,
.decal-inspector-button-row {
    flex-direction: row;
    margin-top: 4px;
}

.sdk-button-row > Button,
.preview-button-row > Button,
.decal-inspector-button-row > Button {
    flex-grow: 1;
    margin-right: 2px;
}

.sdk-button-row > Button:last-child,
.preview-button-row > Button:last-child,
.decal-inspector-button-row > Button:last-child {
    margin-right: 0;
}

/* ----- Action buttons (full-width 22px tall) ---------------------------- */

.sdk-action-button,
.preview-stop-button,
.preview-action-button,
.preview-jump-button {
    height: 22px;
}

.preview-action-button {
    margin-top: 4px;
}

.preview-jump-button {
    margin-bottom: 2px;
}

/* ----- Hints (muted italic helper text) --------------------------------- */

.sdk-hint,
.decal-controller-hint,
.decal-inspector-hint,
.pqs-inspector-empty-selection {
    -unity-font-style: italic;
    color: rgb(153, 153, 153);
    white-space: normal;
}

.decal-controller-hint {
    margin-top: 4px;
}

.decal-inspector-hint {
    margin-bottom: 4px;
}

.pqs-inspector-empty-selection {
    margin-top: 4px;
    margin-bottom: 4px;
}

/* ----- Tile grid (palette / biome x layer / etc.) ----------------------- */

.sdk-tile-grid {
    flex-direction: column;
    margin-top: 4px;
    margin-left: 8px;
}

.sdk-tile-grid-row {
    flex-direction: row;
    align-items: center;
}

.sdk-tile-grid-corner {
    width: 18px;
    flex-shrink: 0;
}

.sdk-tile-grid-row-header {
    width: 18px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(190, 200, 220);
    font-size: 10px;
}

.sdk-tile-grid-col-header {
    width: 24px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(190, 200, 220);
    font-size: 10px;
    margin-left: 2px;
    margin-right: 2px;
}

.sdk-tile-grid-cell {
    width: 24px;
    height: 20px;
    flex-shrink: 0;
    margin: 2px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.4);
    border-right-color: rgba(0, 0, 0, 0.4);
    border-top-color: rgba(0, 0, 0, 0.4);
    border-bottom-color: rgba(0, 0, 0, 0.4);
}

.sdk-tile-grid-cell--disabled {
    opacity: 0.25;
    border-left-color: rgba(120, 120, 120, 0.6);
    border-right-color: rgba(120, 120, 120, 0.6);
    border-top-color: rgba(120, 120, 120, 0.6);
    border-bottom-color: rgba(120, 120, 120, 0.6);
}

.sdk-tile-grid-cell:hover {
    border-left-color: rgb(95, 150, 210);
    border-right-color: rgb(95, 150, 210);
    border-top-color: rgb(95, 150, 210);
    border-bottom-color: rgb(95, 150, 210);
}

/* ----- Validation issue styling ----------------------------------------- */

.validation-header {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.validation-header--clean {
    color: rgb(110, 200, 110);
}

.validation-header--issues {
    color: rgb(220, 130, 80);
}

.validation-issue-row {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 4px;
    padding-left: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-left-width: 3px;
    border-left-color: rgb(80, 80, 80);
}

.validation-issue-row--info {
    border-left-color: rgb(90, 150, 220);
}

.validation-issue-row--warning {
    border-left-color: rgb(220, 165, 80);
}

.validation-issue-row--error {
    border-left-color: rgb(220, 80, 80);
}

.validation-issue-label {
    white-space: normal;
}

.validation-issue-fixes {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
}

.validation-issue-fix {
    margin-right: 4px;
}

/* ----- AutocompleteField (and its specialisations) --------------------- */

.autocomplete-field {
    flex-direction: column;
    position: relative;
}

.autocomplete-field > .unity-base-field {
    margin: 0;
}

.autocomplete-field__suggestions {
    position: absolute;
    max-height: 140px;
    background-color: rgb(28, 32, 40);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(85, 100, 125);
    border-right-color: rgb(85, 100, 125);
    border-top-color: rgb(85, 100, 125);
    border-bottom-color: rgb(85, 100, 125);
    border-radius: 3px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.autocomplete-field__suggestion {
    -unity-text-align: middle-left;
    padding: 0 10px;
    color: rgb(255, 255, 255);
    font-size: 12px;
    background-color: rgba(0, 0, 0, 0);
}

.autocomplete-field__suggestion:hover,
.autocomplete-field__suggestion--highlighted {
    background-color: rgba(95, 150, 210, 0.55);
    color: rgb(245, 250, 255);
}

.autocomplete-field__no-matches {
    color: rgb(150, 160, 175);
    -unity-font-style: italic;
}

/* ----- Shared inspector chrome ------------------------------------------
 * Validation chip and Quick Tools, instanced from
 * Inspectors/Shared/PlanetAuthoringChrome.uxml by every inspector that
 * targets a celestial body. These rules previously lived only in
 * CelestialBodyInspector.uss, so the same markup rendered unstyled on the
 * PQS inspector once the chrome was shared.
 * ---------------------------------------------------------------------- */

.validation-chip {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 4px;
}

.validation-chip-label {
    flex-grow: 1;
    white-space: normal;
    -unity-font-style: bold;
}

.validation-chip-label.validation-chip--clean {
    color: rgb(110, 200, 110);
}

.validation-chip-label.validation-chip--issues {
    color: rgb(220, 130, 80);
}

.validation-chip-open {
    flex-shrink: 0;
}

.body-inspector-quick-tools {
    margin-bottom: 6px;
}

.body-inspector-error-label {
    flex-grow: 1;
    white-space: normal;
}

.body-inspector-error-fix {
    flex-shrink: 0;
}

/* ----- Widgets ----------------------------------------------------------
 * Styling for the reusable widgets in Editor/Widgets/. They live here rather
 * than in a module sheet so a widget works in any tool without its consumer
 * knowing which stylesheet to apply, matching how autocomplete-field__* above
 * is already handled. The .data-editor-* aliases keep part authoring's own
 * direct uses of these names working unchanged.
 * ---------------------------------------------------------------------- */

.sdk-inline-list,
.data-editor-inline-list {
    margin-top: 4px;
    margin-bottom: 4px;
}

.sdk-inline-list__header,
.data-editor-inline-list__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.sdk-inline-list__count,
.data-editor-inline-list__count {
    flex-grow: 1;
    margin-bottom: 0;
}

.sdk-inline-list__add-btn,
.data-editor-inline-list__add-btn {
    flex-shrink: 0;
}

.sdk-inline-list__title {
    -unity-font-style: bold;
    color: rgb(195, 205, 220);
    font-size: 11px;
    margin-bottom: 2px;
}

.sdk-inline-list__empty {
    color: rgb(160, 170, 185);
    -unity-font-style: italic;
}

/* Card list widgets: CardShell and CardListSection in Editor/Widgets/. Same reasoning as the
 * inline list above, so a card list works in any tool without its consumer applying a module
 * stylesheet. The .data-editor-* aliases keep part authoring's markup and its own direct uses
 * of these names working unchanged. */

.sdk-card,
.data-editor-card {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.45);
    border-right-color: rgba(0, 0, 0, 0.45);
    border-top-color: rgba(0, 0, 0, 0.45);
    border-bottom-color: rgba(0, 0, 0, 0.45);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding-bottom: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.sdk-card__header,
.data-editor-card-header {
    flex-direction: row;
    align-items: center;
    background-color: rgba(70, 100, 140, 0.25);
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 6px;
    padding-right: 4px;
    margin-bottom: 4px;
}

.sdk-card__disclosure,
.data-editor-card-disclosure {
    width: 18px;
    height: 18px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 4px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgb(220, 230, 245);
    -unity-text-align: middle-center;
    font-size: 10px;
    flex-shrink: 0;
}

.sdk-card__name-field,
.data-editor-card-name-field {
    flex-grow: 1;
    margin-right: 6px;
}

.sdk-card__chip-slot,
.data-editor-card-chip-slot {
    flex-direction: row;
    align-items: center;
}

.sdk-card__chip,
.data-editor-card-summary-chip {
    margin-right: 6px;
    color: rgb(180, 195, 215);
}

.sdk-card__remove-btn,
.data-editor-card-remove-btn {
    width: 22px;
    height: 20px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.sdk-card__body,
.data-editor-card-body {
    padding-top: 4px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
}

.sdk-card-list,
.data-editor-section {
    margin-top: 4px;
}

.sdk-card-list__header,
.data-editor-section-header-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 2px;
}

.sdk-card-list__title,
.data-editor-section-header {
    -unity-font-style: bold;
    color: rgb(210, 220, 235);
    flex-grow: 1;
}

.sdk-card-list__items,
.data-editor-section-list {
    flex-direction: column;
}

.sdk-card-list__empty,
.data-editor-section-empty {
    -unity-font-style: italic;
    color: rgb(153, 153, 153);
    font-size: 11px;
    padding: 2px 4px;
}

.sdk-card__move-btn {
    width: 18px;
    height: 20px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 2px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
    font-size: 9px;
    flex-shrink: 0;
}

/* Subsection foldout: a field-cluster header inside a card body. In the common sheet with the
 * other widget chrome, since any card list body wants the same grouping. */

.sdk-subsection-foldout,
.data-editor-subsection-foldout {
    margin-top: 4px;
    margin-bottom: 2px;
}

.sdk-subsection-foldout > .unity-foldout__toggle,
.data-editor-subsection-foldout > .unity-foldout__toggle {
    background-color: rgba(70, 100, 140, 0.18);
    border-left-width: 2px;
    border-left-color: rgba(95, 150, 210, 0.55);
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 4px;
    margin-bottom: 0;
}

.sdk-subsection-foldout > .unity-foldout__toggle Label,
.data-editor-subsection-foldout > .unity-foldout__toggle Label {
    -unity-font-style: bold;
    color: rgb(220, 230, 245);
}

.sdk-subsection-foldout > .unity-foldout__content,
.data-editor-subsection-foldout > .unity-foldout__content {
    padding-top: 2px;
    padding-bottom: 4px;
    padding-left: 8px;
    margin-left: 0;
}

.sdk-subsection-foldout .unity-decorator-drawers-container,
.data-editor-subsection-foldout .unity-decorator-drawers-container {
    display: none;
}

/* Subsections sit inside a card, so they are inset from its edges and separated from each other.
 * Without this they run edge to edge and read as siblings of the card's own header rather than as
 * content within it.
 *
 * Descendant rather than child selectors on purpose: a card body may hold a binding wrapper and the
 * cloned UXML's own root before reaching the foldouts, so the nesting depth is not fixed. Scoped to
 * the sdk- name so part authoring cards keep their existing look. */

.sdk-card__body .sdk-subsection-foldout {
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 6px;
}
