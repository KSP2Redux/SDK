<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="toolbar" class="tech-tree-toolbar">
        <ui:Button name="features-chip" class="sdk-tool-chip tech-tree-toolbar__features" tooltip="The features the tree loads under. Edit them in the tree's settings." />
        <ui:VisualElement class="tech-tree-toolbar__spacer" />
        <ui:VisualElement name="find-host" class="tech-tree-toolbar__find" />
        <ui:Button name="readiness-chip-valid" class="sdk-readiness-chip tech-tree-toolbar__chip" />
        <ui:Button name="chip-export-localizations" text="Export Localizations" class="sdk-tool-chip tech-tree-toolbar__chip" />
        <ui:Button name="chip-bake-json" text="Bake JSON" class="sdk-tool-chip tech-tree-toolbar__chip" />
    </ui:VisualElement>
    <ui:VisualElement name="body" class="tech-tree-body">
        <ui:ScrollView name="side-panel" class="tech-tree-panel" />
        <ui:VisualElement name="canvas-host" class="tech-tree-canvas-host">
            <ui:VisualElement class="tech-tree-overlay tech-tree-overlay--top" picking-mode="Ignore">
                <ui:VisualElement class="sdk-tab-bar tech-tree-overlay__modes">
                    <ui:Button name="tab-authoring" text="Authoring" class="sdk-tab" />
                    <ui:Button name="tab-preview" text="Preview unlocks" class="sdk-tab" />
                </ui:VisualElement>
                <ui:Button name="pill-snap" text="Snap 180 × 110" class="sdk-pill" />
                <ui:Button name="pill-grid" text="Grid" class="sdk-pill" />
                <ui:Button name="pill-pages" text="Tier pages" class="sdk-pill" />
                <ui:Button name="pill-band" text="Visible band" class="sdk-pill" />
            </ui:VisualElement>
            <ui:Label name="cursor-label" class="tech-tree-overlay tech-tree-overlay--bottom-left tech-tree-overlay__cursor" picking-mode="Ignore" />
            <ui:VisualElement class="tech-tree-overlay tech-tree-overlay--bottom-right" picking-mode="Ignore">
                <ui:Button name="chip-zoom-out" text="-" class="sdk-tool-chip" tooltip="Zoom out" />
                <ui:Label name="zoom-label" text="100%" class="sdk-tool-chip tech-tree-overlay__zoom" />
                <ui:Button name="chip-zoom-in" text="+" class="sdk-tool-chip" tooltip="Zoom in" />
                <ui:Button name="chip-frame-all" text="Frame all" class="sdk-tool-chip" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
