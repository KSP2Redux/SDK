/* Layout: a toolbar across the top, the side panel on the left, the canvas filling the rest with its controls over it. */
/* Canvas colours are the R&D Center's own, read from its prefab, frame sprites and tier art. */

.tech-tree-window {
    flex-grow: 1;
}

.tech-tree-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 4px 6px 0 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
}

.tech-tree-toolbar__spacer {
    flex-grow: 1;
}

.tech-tree-toolbar__find {
    width: 240px;
    margin-right: 6px;
    margin-bottom: 4px;
}

.tech-tree-toolbar__chip {
    margin-left: 0;
}

.tech-tree-canvas-host {
    flex-grow: 1;
}

/* The canvas's controls float over its corners */
.tech-tree-overlay {
    position: absolute;
    flex-direction: row;
    align-items: center;
}

.tech-tree-overlay--top {
    left: 8px;
    top: 8px;
}

.tech-tree-overlay--bottom-left {
    left: 8px;
    bottom: 8px;
}

.tech-tree-overlay--bottom-right {
    right: 8px;
    bottom: 4px;
}

.tech-tree-overlay__modes {
    margin: 0 6px 4px 0;
}

.tech-tree-overlay__cursor {
    font-size: 11px;
    color: rgb(170, 180, 195);
    background-color: rgba(30, 32, 40, 0.8);
    padding: 2px 6px;
    border-radius: 3px;
}

.tech-tree-overlay__zoom {
    min-width: 44px;
    -unity-text-align: middle-center;
}

.tech-tree-body {
    flex-direction: row;
    flex-grow: 1;
}

.tech-tree-panel {
    width: 340px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: rgb(35, 35, 35);
}

.tech-tree-panel > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 0 4px 6px 4px;
}

.tech-tree-panel__description TextInput {
    min-height: 48px;
    white-space: normal;
}

.tech-tree-panel__node-link {
    -unity-text-align: middle-left;
}

.tech-tree-canvas {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgb(8, 8, 20);
}

/* An inspector has no height of its own to fill */
.tech-tree-canvas--inspector {
    flex-grow: 0;
    height: 420px;
}

/* Scaled about its top-left, so pan and zoom are a translate and a scale with no offset */
.tech-tree-canvas__content {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
}

.tech-tree-canvas__layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.tech-tree-page-label {
    position: absolute;
    top: 6px;
    color: rgb(144, 151, 175);
    font-size: 11px;
    -unity-font-style: bold;
}

/* The locked frame: 1 unit border on top and sides, a 4 unit lip at the bottom, a darker header band */
/* The frame's opaque 152 by 90. The prefab lays children out in the full 164 by 102 rect, 6 units further out,
   so each child's offset below is the prefab's less 6. */
.tech-tree-node {
    position: absolute;
    width: 152px;
    height: 90px;
    background-color: rgb(38, 42, 51);
    border-width: 1px 1px 4px 1px;
    border-color: rgb(82, 89, 99);
    border-radius: 5px;
}

/* The R&D Center's unlockable and unlocked frames */
.tech-tree-node--unlockable {
    border-color: rgb(181, 190, 214);
    background-color: rgb(93, 98, 112);
}

.tech-tree-node--unlockable > .tech-tree-node__header {
    background-color: rgb(74, 78, 90);
}

.tech-tree-node--unlocked {
    border-color: rgb(0, 170, 66);
    background-color: rgb(0, 74, 29);
}

.tech-tree-node--unlocked > .tech-tree-node__header {
    background-color: rgb(0, 60, 24);
}

/* Warning and error marks are the readiness chip's glyphs in the validation row colours */
.tech-tree-node__badge {
    position: absolute;
    left: -9px;
    top: -9px;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: rgb(30, 32, 40);
    color: rgb(220, 165, 80);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.tech-tree-node__badge--error {
    color: rgb(220, 80, 80);
}

.tech-tree-node--reference {
    opacity: 0.55;
}

.tech-tree-node--selected {
    border-color: rgb(91, 95, 219);
    border-width: 2px 2px 5px 2px;
}

.tech-tree-node__header {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 30px;
    background-color: rgb(29, 37, 44);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.tech-tree-node__icon {
    position: absolute;
    left: 9px;
    top: 4px;
    width: 24px;
    height: 24px;
}

.tech-tree-node__name {
    position: absolute;
    left: 9px;
    top: 34px;
    width: 134px;
    color: rgb(255, 255, 255);
    font-size: 12px;
    white-space: normal;
    padding: 0;
    margin: 0;
}

.tech-tree-node__cost {
    position: absolute;
    right: 5px;
    top: 6px;
    width: 65px;
    height: 16px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.23);
}

.tech-tree-node__cost > Label {
    color: rgb(255, 255, 255);
    font-size: 13px;
    padding: 0 3px 0 0;
    margin: 0;
}

.tech-tree-node__science {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(95, 191, 228);
    margin-right: 3px;
}

.tech-tree-panel__tier-number {
    width: 20px;
    -unity-text-align: middle-left;
    color: rgb(170, 180, 195);
}

.tech-tree-panel__jump {
    font-size: 9px;
}

/* The mode tabs sit side by side, as one segmented control */
.tech-tree-overlay__modes {
    flex-wrap: nowrap;
}

/* A node the patch removes stays on the canvas, faded and edged in the validation error colour, so it can be restored */
.tech-tree-node--removed {
    opacity: 0.3;
    border-color: rgb(220, 80, 80);
}

.tech-tree-panel__actions {
    margin: 0 0 4px 0;
}
