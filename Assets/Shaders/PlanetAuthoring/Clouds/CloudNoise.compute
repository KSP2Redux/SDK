// Bakes tileable 3D cloud noise for the SDK cloud tools.
//
// A port of the game's CPU generators, KSP.VolumeCloud.PerlinNoiseGenerator.OctaveNoise and
// WorleyNoiseGenerator.OctaveNoise, so a bake matches what those functions return voxel for voxel.
// Worley seeds UnityEngine.Random per cell, so Unity's xorshift128 generator is reproduced below.
// The stock studio kernel these replaced is not shipped.

#pragma kernel BakePerlin
#pragma kernel BakeWorley
#pragma kernel BakeDistribution
#pragma kernel EvaluateDistribution
#pragma kernel ProbeCubemap

RWStructuredBuffer<float> _Result;
uint _Resolution;
int _Period;
int _Octaves;
float _Persistence;

static const int PERM[257] =
{
    151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30,
    69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62,
    94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136,
    171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122,
    60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161,
    1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86,
    164, 100, 109, 198, 173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126,
    255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213,
    119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253,
    19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193,
    238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31,
    181, 199, 106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93,
    222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180, 151
};

float Fade(float t)
{
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

float Grad(int hash, float x, float y, float z)
{
    int h = hash & 0xF;
    float u = h < 8 ? x : y;
    float v = h < 4 ? y : (h == 12 || h == 14 ? x : z);
    return ((h & 1) == 0 ? u : -u) + ((h & 2) == 0 ? v : -v);
}

// The CPU generator's own wrap: it steps the index on by one before wrapping.
int PerlinWrap(int n, int period)
{
    n++;
    return period <= 0 ? n : n % period;
}

float PerlinNoise(float3 pos, int period)
{
    pos *= period;
    int X = (int)floor(pos.x) & 0xFF;
    int Y = (int)floor(pos.y) & 0xFF;
    int Z = (int)floor(pos.z) & 0xFF;
    float x = pos.x - floor(pos.x);
    float y = pos.y - floor(pos.y);
    float z = pos.z - floor(pos.z);
    float u = Fade(x);
    float v = Fade(y);
    float w = Fade(z);
    int A = (PERM[PerlinWrap(X, period)] + Y) & 0xFF;
    int B = (PERM[PerlinWrap(X + 1, period)] + Y) & 0xFF;
    int AA = (PERM[PerlinWrap(A, period)] + Z) & 0xFF;
    int BA = (PERM[PerlinWrap(B, period)] + Z) & 0xFF;
    int AB = (PERM[PerlinWrap(A + 1, period)] + Z) & 0xFF;
    int BB = (PERM[PerlinWrap(B + 1, period)] + Z) & 0xFF;
    float near = lerp(
        lerp(Grad(PERM[AA], x, y, z), Grad(PERM[BA], x - 1.0, y, z), u),
        lerp(Grad(PERM[AB], x, y - 1.0, z), Grad(PERM[BB], x - 1.0, y - 1.0, z), u),
        v);
    float far = lerp(
        lerp(Grad(PERM[AA + 1], x, y, z - 1.0), Grad(PERM[BA + 1], x - 1.0, y, z - 1.0), u),
        lerp(Grad(PERM[AB + 1], x, y - 1.0, z - 1.0), Grad(PERM[BB + 1], x - 1.0, y - 1.0, z - 1.0), u),
        v);
    return (lerp(near, far, w) + 1.0) / 2.0;
}

float PerlinOctaves(float3 pos, int period, int octaves, float persistence)
{
    if (octaves == 0)
        return 0.0;

    float total = 0.0;
    float result = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    for (int i = 0; i < octaves; i++)
    {
        total += amp;
        result += (PerlinNoise(pos, (int)round(freq * period)) * 2.0 - 1.0) * amp;
        amp *= persistence;
        freq *= 2.0;
    }

    return (result / total + 1.0) / 2.0;
}

// UnityEngine.Random: xorshift128, seeded the way Random.InitState seeds it.
struct UnityRandom
{
    uint s0;
    uint s1;
    uint s2;
    uint s3;
};

UnityRandom InitRandom(uint seed)
{
    UnityRandom r;
    r.s0 = seed;
    r.s1 = r.s0 * 1812433253u + 1u;
    r.s2 = r.s1 * 1812433253u + 1u;
    r.s3 = r.s2 * 1812433253u + 1u;
    return r;
}

float NextValue(inout UnityRandom r)
{
    uint t = r.s0 ^ (r.s0 << 11);
    r.s0 = r.s1;
    r.s1 = r.s2;
    r.s2 = r.s3;
    r.s3 = r.s3 ^ (r.s3 >> 19) ^ t ^ (t >> 8);
    return (float)(r.s3 & 0x7FFFFFu) * (1.0 / 8388607.0);
}

int WorleyWrap(int n, int period)
{
    return n < 0 ? period + n : n % period;
}

float WorleyNoise(float3 pos, int period)
{
    pos *= period;
    int3 box = int3(floor(pos));
    float minDistance = 3.402823466e+38;
    for (int xo = -1; xo <= 1; xo++)
    {
        for (int yo = -1; yo <= 1; yo++)
        {
            for (int zo = -1; zo <= 1; zo++)
            {
                int3 cell = box + int3(xo, yo, zo);
                int seed = (WorleyWrap(cell.x, period) + WorleyWrap(cell.y, period) * 131 + WorleyWrap(cell.z, period) * 17161) % 2147483647;
                UnityRandom r = InitRandom((uint)seed);
                float px = NextValue(r) + cell.x;
                float py = NextValue(r) + cell.y;
                float pz = NextValue(r) + cell.z;
                minDistance = min(minDistance, distance(float3(px, py, pz), pos));
            }
        }
    }

    return 1.0 - minDistance;
}

float WorleyOctaves(float3 pos, int period, int octaves, float persistence)
{
    if (octaves == 0)
        return 0.0;

    float result = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    float totalAmp = 0.0;
    for (int i = 0; i < octaves; i++)
    {
        totalAmp += amp;
        result += WorleyNoise(pos, (int)round(freq * period)) * amp;
        amp *= persistence;
        freq /= persistence;
    }

    return result / totalAmp;
}

uint VoxelIndex(uint3 id)
{
    return id.x + id.y * _Resolution + id.z * _Resolution * _Resolution;
}

float3 VoxelPosition(uint3 id)
{
    return float3(id) / _Resolution;
}

[numthreads(4, 4, 4)]
void BakePerlin(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= _Resolution))
        return;

    _Result[VoxelIndex(id)] = PerlinOctaves(VoxelPosition(id), _Period, _Octaves, _Persistence);
}

[numthreads(4, 4, 4)]
void BakeWorley(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= _Resolution))
        return;

    _Result[VoxelIndex(id)] = WorleyOctaves(VoxelPosition(id), _Period, _Octaves, _Persistence);
}

// Distribution maps: where a cloud layer forms over the body, as a single-channel cubemap the cloud shaders read
// through .x. Noise is evaluated in 3D at each texel's direction on the unit sphere, so the map is seamless across
// face edges and does not pinch at the poles.

float _Frequency;
float3 _SeedOffset;
float _Roughness;
float _WarpStrength;
float _Coverage;
float _Softness;
StructuredBuffer<float> _LatitudeProfile;
uint _LatitudeSamples;
StructuredBuffer<float3> _Directions;
uint _DirectionCount;
TextureCube<float4> _Probe;
SamplerState sampler_Probe;

// Lattice-periodic Perlin with a 256 cell period, which a sphere sample never reaches at useful frequencies.
float SpherePerlin(float3 p)
{
    return PerlinNoise(p / 256.0, 256);
}

float SphereOctaves(float3 p, int octaves, float persistence)
{
    if (octaves == 0)
        return 0.5;

    float total = 0.0;
    float result = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    for (int i = 0; i < octaves; i++)
    {
        total += amp;
        result += (SpherePerlin(p * freq) * 2.0 - 1.0) * amp;
        amp *= persistence;
        freq *= 2.0;
    }

    return (result / total + 1.0) / 2.0;
}

float LatitudeFactor(float3 direction)
{
    // 0 at the equator, 1 at either pole.
    float latitude = abs(asin(clamp(direction.y, -1.0, 1.0))) / 1.5707963;
    float position = latitude * (_LatitudeSamples - 1);
    uint lower = (uint)floor(position);
    uint upper = min(lower + 1, _LatitudeSamples - 1);
    return lerp(_LatitudeProfile[lower], _LatitudeProfile[upper], position - lower);
}

float Distribution(float3 direction)
{
    float3 p = direction * _Frequency + _SeedOffset;
    // Domain warp bends the noise into streaks and swirls, which is what makes a map read as weather.
    float3 warp = float3(
        SphereOctaves(p + float3(17.3, 0.0, 0.0), 3, 0.5),
        SphereOctaves(p + float3(0.0, 41.7, 0.0), 3, 0.5),
        SphereOctaves(p + float3(0.0, 0.0, 73.1), 3, 0.5)) - 0.5;
    float n = SphereOctaves(p + warp * _WarpStrength, _Octaves, _Roughness);
    float threshold = 1.0 - _Coverage;
    float covered = smoothstep(threshold - _Softness, threshold + _Softness, n);
    return saturate(covered * LatitudeFactor(direction));
}

// Unity cube faces in order +X, -X, +Y, -Y, +Z, -Z, with texel rows running down each face.
float3 FaceDirection(uint face, uint2 texel)
{
    float u = 2.0 * (texel.x + 0.5) / _Resolution - 1.0;
    float v = 2.0 * (texel.y + 0.5) / _Resolution - 1.0;
    float3 direction;
    switch (face)
    {
        case 0: direction = float3(1.0, -v, -u); break;
        case 1: direction = float3(-1.0, -v, u); break;
        case 2: direction = float3(u, 1.0, v); break;
        case 3: direction = float3(u, -1.0, -v); break;
        case 4: direction = float3(u, -v, 1.0); break;
        default: direction = float3(-u, -v, -1.0); break;
    }

    return normalize(direction);
}

[numthreads(8, 8, 1)]
void BakeDistribution(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution || id.z >= 6)
        return;

    _Result[id.z * _Resolution * _Resolution + id.y * _Resolution + id.x] = Distribution(FaceDirection(id.z, id.xy));
}

[numthreads(64, 1, 1)]
void EvaluateDistribution(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _DirectionCount)
        return;

    _Result[id.x] = Distribution(normalize(_Directions[id.x]));
}

[numthreads(64, 1, 1)]
void ProbeCubemap(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _DirectionCount)
        return;

    _Result[id.x] = _Probe.SampleLevel(sampler_Probe, normalize(_Directions[id.x]), 0).x;
}
