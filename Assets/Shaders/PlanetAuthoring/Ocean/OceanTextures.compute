// Bakes the tiling textures an ocean material samples: caustics, foam shapes and the slopes its normal maps are built
// from. Every pattern is periodic over the texture, so each one tiles without a seam. Stock's ocean textures live in
// the game's bundles where an SDK material cannot reference them, so bodies get their own.

#pragma kernel BakeCaustics
#pragma kernel BakeFoam
#pragma kernel BakeSlopes

RWStructuredBuffer<float4> _Result;
uint _Resolution;
uint _Seed;
int2 _Cells;
int _Octaves;
float _Roughness;
float _Warp;
float _Sharpness;
float _Fringe;

uint Hash(uint3 v)
{
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    return v.x ^ v.y ^ v.z;
}

// Two values in [0, 1] for a lattice cell, wrapped so the lattice repeats every period cells.
float2 CellRandom(int2 cell, int2 period, uint salt)
{
    // Cells reach at most one period below zero, so an offset keeps the wrap in unsigned arithmetic.
    uint2 wrapped = (uint2)(cell + period * 4) % (uint2)period;
    uint a = Hash(uint3(wrapped, _Seed * 7919u + salt));
    uint b = Hash(uint3(wrapped.yx + 17u, _Seed * 104729u + salt + 1u));
    return float2(a & 0xFFFFFFu, b & 0xFFFFFFu) / 16777215.0;
}

float2 Gradient(int2 cell, int2 period, uint salt)
{
    float angle = CellRandom(cell, period, salt).x * 6.28318530718;
    return float2(cos(angle), sin(angle));
}

// Gradient noise repeating every period cells over uv in [0, 1), roughly in [-0.7, 0.7].
float Perlin(float2 uv, int2 period, uint salt)
{
    float2 p = uv * period;
    int2 i = (int2)floor(p);
    float2 f = p - i;
    float2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float a = dot(Gradient(i, period, salt), f);
    float b = dot(Gradient(i + int2(1, 0), period, salt), f - float2(1.0, 0.0));
    float c = dot(Gradient(i + int2(0, 1), period, salt), f - float2(0.0, 1.0));
    float d = dot(Gradient(i + int2(1, 1), period, salt), f - float2(1.0, 1.0));
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

// Octaves double the period, so the sum repeats with the first one.
float Fbm(float2 uv, int2 period, int octaves, float roughness, uint salt)
{
    float sum = 0.0;
    float amplitude = 1.0;
    float norm = 0.0;
    for (int i = 0; i < octaves; i++)
    {
        sum += Perlin(uv, period << i, salt + (uint)i * 31u) * amplitude;
        norm += amplitude;
        amplitude *= roughness;
    }

    return sum / norm;
}

// The distances to the nearest and second nearest feature points, in cells.
float2 Worley(float2 uv, int2 period, uint salt)
{
    float2 p = uv * period;
    int2 i = (int2)floor(p);
    float2 f = p - i;
    float nearest = 8.0;
    float second = 8.0;
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            int2 offset = int2(x, y);
            float distanceToPoint = length(offset + CellRandom(i + offset, period, salt) - f);
            if (distanceToPoint < nearest)
            {
                second = nearest;
                nearest = distanceToPoint;
            }
            else if (distanceToPoint < second)
            {
                second = distanceToPoint;
            }
        }
    }

    return float2(nearest, second);
}

float2 TexelUv(uint2 texel)
{
    return (float2(texel) + 0.5) / _Resolution;
}

// Bends the cells into rounded, uneven shapes. The bend is a single smooth octave at the cell scale, so borders stay
// smooth curves rather than jagged ones, and it is periodic, so the tiling holds.
float2 WarpUv(float2 uv)
{
    int2 period = max(_Cells, int2(1, 1));
    float2 bend = float2(Perlin(uv, period, 101u), Perlin(uv, period, 202u));
    return uv + bend * _Warp / period;
}

// Bright where the two nearest cell points are equally far, which traces the borders between cells. A slight bend at
// the cells' own scale curves the borders, which would otherwise be straight polygon edges.
float Veins(float2 uv, int2 period, float sharpness, uint salt)
{
    float2 bend = float2(Perlin(uv, period, salt + 50u), Perlin(uv, period, salt + 60u));
    float2 distances = Worley(uv + bend * 0.45 / period, period, salt);
    return exp(-(distances.y - distances.x) * sharpness);
}

float Caustic(float2 uv)
{
    float2 warped = WarpUv(uv);
    // A thin bright line along each border over a soft glow that fades into the cell, as light focused by a wave does.
    float2 distances = Worley(warped, _Cells, 7u);
    float edge = distances.y - distances.x;
    return saturate(exp(-edge * _Sharpness) + 0.3 * exp(-edge * _Sharpness * 0.2));
}

[numthreads(8, 8, 1)]
void BakeCaustics(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution)
        return;

    float2 uv = TexelUv(id.xy);
    float2 shift = float2(_Fringe, _Fringe * 0.5);
    // Each channel is the pattern displaced a little, the colour fringing dispersion gives real caustics.
    float red = Caustic(uv + shift);
    float green = Caustic(uv);
    float blue = Caustic(uv - shift);
    _Result[id.y * _Resolution + id.x] = float4(red, green, blue, 1.0);
}

[numthreads(8, 8, 1)]
void BakeFoam(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution)
        return;

    float2 uv = TexelUv(id.xy);
    // A web of bright bubble walls at two scales, over fractal mottling that thickens and thins it. Only the mottling
    // is bent, since a bend at its scale smears the much smaller walls into streaks.
    float broad = 0.5 + Fbm(WarpUv(uv), _Cells, _Octaves, _Roughness, 11u) * 0.7;
    float walls = Veins(uv, _Cells * 5, 5.0, 13u);
    float fine = Veins(uv, _Cells * 14, 7.0, 17u);
    // Raw, since the baker centres it on the requested coverage, which needs the whole texture's average.
    float raw = broad * 0.45 + walls * 0.35 + fine * 0.2;
    _Result[id.y * _Resolution + id.x] = float4(raw, raw, raw, 1.0);
}

float Height(float2 uv)
{
    return Fbm(WarpUv(uv), _Cells, _Octaves, _Roughness, 23u);
}

// The height's slope along each axis, per tile. The baker scales them to the requested bumpiness.
[numthreads(8, 8, 1)]
void BakeSlopes(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution)
        return;

    float2 uv = TexelUv(id.xy);
    float step = 1.0 / _Resolution;
    float slopeX = (Height(uv + float2(step, 0.0)) - Height(uv - float2(step, 0.0))) / (2.0 * step);
    float slopeY = (Height(uv + float2(0.0, step)) - Height(uv - float2(0.0, step))) / (2.0 * step);
    _Result[id.y * _Resolution + id.x] = float4(slopeX, slopeY, 0.0, 0.0);
}
