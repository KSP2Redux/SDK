/*region ============ Root element ============ */

/*noinspection CssInvalidPseudoSelector*/
:root {
    /*noinspection CssUnknownTarget*/
    --font-regular: url('Fonts/JetBrainsMono/JetBrainsMono-Regular SDF.asset');
    /*noinspection CssUnknownTarget*/
    --font-medium: url('Fonts/JetBrainsMono/JetBrainsMono-Medium SDF.asset');
    /*noinspection CssUnknownTarget*/
    --font-bold: url('Fonts/JetBrainsMono/JetBrainsMono-Bold SDF.asset');
    /*noinspection CssUnknownTarget*/
    --font-title-big: url('Fonts/LEDCounter7/led_counter-7 SDF.asset');
    /*noinspection CssUnknownTarget*/
    --font-title-big-italic: url('Fonts/LEDCounter7/led_counter-7_italic SDF.asset');
    /*noinspection CssUnknownTarget*/
    --font-title-small: url('Fonts/SFPixelate/pixelate SDF.asset');
    /*noinspection CssUnknownTarget*/
    --font-title-small-bold: url('Fonts/SFPixelate/pixelate SDF.asset');
    /*noinspection CssUnknownTarget*/
    --font-title-small-italic: url('Fonts/SFPixelate/pixelate SDF.asset');
    /*noinspection CssInvalidFunction,CssUnresolvedCustomProperty,CssUnknownProperty*/
    -unity-font-definition: var(--font-bold);
    color: #c0c7d5;
}

.root {
    padding: 8px;
    border-radius: 5px;
    background-color: #22262e;
    border-color: rgba(60, 62, 146, 0.5);
    border-width: 1px;
    font-size: 14px;
}

/* endregion */

/* region ============ ScrollView ============ */

.unity-scroll-view {
    width: 100%;
    height: 100%;
    background-color: #1e2129;
    border-radius: 6px;
    padding: 8px;
}

/* endregion */

/* region ============ ListView ============ */

.unity-list-view > .unity-scroll-view {
    width: 100%;
    height: 100%;
    background-color: initial;
    border-radius: 6px;
    padding: 8px;
}

/* endregion */

/* region ============ Scroller ============ */

.unity-scroller--vertical {
    margin-left: 2px;
    margin-right: -4px;
    width: 8px;
}

.unity-scroller--horizontal {
    margin-top: 2px;
    margin-bottom: -4px;
    height: 8px;
}

.unity-scroller--vertical > .unity-base-field {
    width: 8px;
    margin: 8px 0;
}

.unity-scroller--horizontal > .unity-base-field {
    height: 8px;
    margin: 0 8px;
}

.unity-scroller--vertical > .unity-base-field > VisualElement {
    width: 8px;
}

.unity-scroller--horizontal > .unity-base-field > VisualElement {
    margin-top: -4px;
    height: 8px;
}

.unity-scroller > .unity-scroller__low-button, .unity-scroller > .unity-scroller__high-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    width: 8px;
    height: 8px;
    -unity-background-image-tint-color: #474e5b;
}

.unity-scroller--vertical .unity-base-slider__drag-container {
    width: 8px;
}

.unity-scroller--horizontal .unity-base-slider__drag-container {
    height: 8px;
}

.unity-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    width: 5px;
    margin-left: 3px;
}

.unity-scroller--horizontal .unity-base-slider__tracker {
    width: 0;
}

.unity-scroller:hover .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroller .unity-base-slider__dragger {
    background-color: #d1d9e1;
    border-width: 0;
    border-radius: 4px;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    margin-left: -1px;
    width: 4px;
}

.unity-scroller--horizontal .unity-base-slider__dragger {
    margin-top: -2px;
    height: 4px;
}

.unity-scroller .unity-base-slider__dragger:hover {
    background-color: #696dff;
}

.unity-scroller > .unity-base-field:focus > .unity-base-slider__input > .unity-base-slider__drag-container .unity-base-slider__dragger {
    background-color: #d1d9e1;
}
.unity-scroller > .unity-base-field:focus > .unity-base-slider__input > .unity-base-slider__drag-container .unity-base-slider__dragger:hover {
    background-color: #696dff;
}

/* endregion */

/* region ============ Sliders ============ */

.unity-base-slider, .unity-min-max-slider {
    margin: 0;
    padding: 4px 0;
}

.unity-base-slider:focus > .unity-base-field__label, .unity-min-max-slider:focus > .unity-base-field__label {
    color: #c0c7d5;
}

.unity-base-slider > .unity-base-field__input, .unity-min-max-slider > .unity-base-field__input {
    background-color: #292f39;
    border-color: #444b57;
    border-width: 1px;
    border-radius: 6px;
}

.unity-base-slider > .unity-base-field__input > .unity-base-slider__drag-container > .unity-base-slider__dragger,
.unity-min-max-slider > .unity-base-field__input > .unity-min-max-slider__dragger > .unity-min-max-slider__min-thumb,
.unity-min-max-slider > .unity-base-field__input > .unity-min-max-slider__dragger > .unity-min-max-slider__max-thumb {
    background-color: #c5e5f5;
    border-color: #9eb8c6;
    border-radius: 4px;
}

.unity-base-slider > .unity-base-field__input > .unity-base-slider__drag-container:active > .unity-base-slider__dragger,
.unity-min-max-slider > .unity-base-field__input:active > .unity-min-max-slider__dragger > .unity-min-max-slider__min-thumb,
.unity-min-max-slider > .unity-base-field__input:active > .unity-min-max-slider__dragger > .unity-min-max-slider__max-thumb {
    background-color: #51698e;
    border-color: #455775;
    cursor: initial;
}

.unity-base-slider--horizontal > .unity-base-field__input > .unity-base-slider__drag-container > .unity-base-slider__tracker {
    height: 1px;
}

.unity-base-slider--vertical > .unity-base-field__input > .unity-base-slider__drag-container > .unity-base-slider__tracker {
    width: 1px;
}

.unity-base-slider > .unity-base-field__input > .unity-base-slider__drag-container > .unity-base-slider__tracker {
    background-color: #82a7e1;
    border-width: 0;
}

.unity-base-slider--horizontal > .unity-base-field__input > .unity-base-slider__drag-container > .unity-base-slider__tracker {
    margin: 0 8px;
}

.unity-base-slider--vertical > .unity-base-field__input > .unity-base-slider__drag-container > .unity-base-slider__tracker {
    margin: 8px 0;
}

.unity-min-max-slider > .unity-base-field__input > .unity-min-max-slider__tracker {
    margin: 0 8px;
    height: 1px;
    border-width: 0;
    background-color: #51698e;
}

.unity-min-max-slider > .unity-base-field__input > .unity-min-max-slider__dragger {
    background-color: #82a7e1;
    margin-top: 0;
    height: 1px;
    border-width: 0;
}

.unity-min-max-slider > .unity-base-field__input > .unity-min-max-slider__dragger > .unity-min-max-slider__min-thumb,
.unity-min-max-slider > .unity-base-field__input > .unity-min-max-slider__dragger > .unity-min-max-slider__max-thumb {
    margin-top: -12px;
}

/* endregion */

/* region ============ Button ============ */

.unity-button {
    height: 30px;
    color: #f2f2f2;
    margin: 0;
    background-color: #0f1318;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    font-size: 14px;
}

.unity-button:hover {
    background-color: #415483;
}

.unity-button:active {
    background-color: #6580c7;
}

.unity-button:focus {
    border-color: rgba(255, 255, 255, 0.2);
}

/* endregion */

/* region ============ Link ============ */
.unity-button.link {
    height: auto;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    border-bottom-color: #c0c7d5;
    border-radius: 0;
}

.unity-button.link:hover {
    border-bottom-color: #415483;
}

/* endregion */

/* region ============ Label ============ */

.unity-label {
    margin: 0;
    color: #c0c7d5;
}

/* endregion */

/* region ============ TextField ============ */

.unity-base-text-field {
    margin: 0;
    padding: 4px 0;
    --unity-cursor-color:#ffffff;
}

.unity-base-text-field > .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0.3);
    border-color: rgba(0, 0, 0, 0);
    padding: 5px;
    margin: 2px 0 0 0;
}

.unity-base-text-field:hover > .unity-base-text-field__input {
    background-color: #001632;
    padding: 5px;
    margin: 2px 0 0 0;
}

.unity-base-text-field:focus > .unity-base-text-field__input {
    background-color: #00260d;
    padding: 5px;
    margin: 2px 0 0 0;
}

.unity-base-text-field > .unity-base-field__label {
    -unity-text-align: middle-left;
}

.unity-base-text-field:focus > .unity-base-field__label {
    color: #c0c7d5;
}

/* endregion */

/* region ============ Toggle ============ */

.unity-toggle.toggle {
    justify-content: space-between;
    margin: 0;
}

.unity-toggle.toggle > .unity-label {
    color: #c0c7d5;
}

/* Unchecked */
.unity-toggle.toggle > .unity-base-field__input {
    border-radius: 6px;
    border-width: 1px;
    border-color: #000000;
    padding: 1px;
    background-color: #666666;
    flex-basis: 40px;
    flex-grow: 0;
    height: 24px;
}

.unity-toggle.toggle > .unity-base-field__input > .unity-toggle__checkmark {
    border-radius: 6px;
    border-width: 1px;
    border-color: #000000;
    background-image: none;
    background-color: #63686e;
    flex-basis: 36px;
    height: 20px;
}

/* Unchecked hover */
.unity-toggle.toggle > .unity-base-field__input:hover {
    background-color: #cccccc;
}

.unity-toggle.toggle > .unity-base-field__input:hover > .unity-toggle__checkmark {
    background-image: none;
    border-color: #000000;
    background-color: #63686e;
}

/* Checked */
.unity-toggle.toggle:checked > .unity-base-field__input {
    background-image: none;
    background-color: #226638;
}

.unity-toggle.toggle:checked > .unity-base-field__input > .unity-toggle__checkmark {
    background-image: none;
    border-color: #000000;
    background-color: #5bffa8;
}

/* Checked hover */
.unity-toggle.toggle:checked > .unity-base-field__input:hover {
    background-color: #51e581;
}

.unity-toggle.toggle:checked > .unity-base-field__input:hover > .unity-toggle__checkmark{
    border-color: #000000;
    background-image: none;
}

/* endregion */

/* region ============ RadioButton ============ */

.unity-radio-button {
    margin: 0;
    padding: 0;
    align-items: flex-end;
}

.unity-radio-button > .unity-radio-button__label {
    font-size: 13px;
    color: #ffffff;
    margin-left: 6px;
}

.unity-radio-button:checked > .unity-radio-button__label,
.unity-radio-button:focus > .unity-radio-button__label {
    color: #ffffff;
}

.unity-radio-button > .unity-radio-button__input {
    width: 20px;
    height: 20px;
    border-radius: 7px;
    border-width: 1px;
    border-color: #b5bcc9;
    padding: 0;
    background-color: #0e1014;
}

.unity-radio-button:hover > .unity-radio-button__input {
    border-color: #7a7f88;
}


.unity-radio-button:checked > .unity-radio-button__input,
.unity-radio-button:focus > .unity-radio-button__input {
    border-color: #00cc53;
}

.unity-radio-button > .unity-radio-button__input > .unity-radio-button__checkmark-background {
    /*background-color: #0e1014;*/
    background-color: transparent;
    padding-top: 6px;
    margin-left: -3px;
}

.unity-radio-button > .unity-radio-button__input .unity-radio-button__checkmark {
    border-radius: 3px;
    width: 10px;
    height: 10px;
    background-color: #00cc53;
}

/* endregion */

/* region ============ Foldout ============ */

.unity-foldout {
    background-color: #2e3540;
    border-radius: 6px;
    border-width: 2px;
    border-color: #354051;
    color: #c0c7d5;
}

.unity-foldout > .unity-foldout__content {
    padding: 0;
    margin: 4px;
}

.unity-foldout > .unity-foldout__toggle {
    color: #d6e0ff;
    margin: 2px;
    border-radius: 6px;
    padding: 4px 0;
}

.unity-foldout > .unity-foldout__toggle:focus .unity-text-element {
    color: #d6e0ff;
}

.unity-foldout > .unity-foldout__toggle:hover {
    background-color: #3f4487;
}

.unity-foldout > .unity-foldout__toggle:checked, .unity-foldout > .unity-foldout__toggle:active {
    background-color: #4b50b0;
}

.unity-foldout > .unity-foldout__toggle Label {
    padding: 0;
    margin: 2px;
    color: #ffffff;
}

.unity-foldout > .unity-foldout__toggle:active Label {
    color: #ffffff;
}

.unity-foldout > .unity-foldout__toggle > .unity-base-field__input {
    -unity-background-image-tint-color: #d5dfff;
}

.unity-foldout > .unity-foldout__toggle > .unity-base-field__input:hover {
    background-color: initial;
}

.unity-foldout > .unity-foldout__toggle > .unity-base-field__input > .unity-toggle__checkmark {
    -unity-background-image-tint-color: #d5dfff;
}

.unity-foldout > .unity-foldout__toggle:active > .unity-base-field__input > .unity-toggle__checkmark {
    -unity-background-image-tint-color: #d5dfff;
}

/* endregion */


/* region ============ Title bar ============ */

#title-bar {
    flex-direction: row;
    margin-bottom: 16px;
    margin-top: 6px;
    align-items: center;
}

#title-bar > .unity-button {
    height: 32px;
    width: 32px;
    margin-right: 10px;
    font-size: 30px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgb(175, 178, 190);
    color: rgb(175, 178, 190);
    border-radius: 8px;
}

#title-bar > .unity-button:hover {
    border-color: #e8ecfe;
    color: #e8ecfe;
}

#title-bar > .unity-button:active {
    border-color: #b4bce4;
    color: #b4bce4;
}

#title-bar > .unity-label {
    -unity-font-definition: var(--font-title-big);
    -unity-text-align: lower-left;
    -unity-font-style: normal;
    font-size: 28px;
    margin-bottom: -4px;
    color: #f4f5f5;
    letter-spacing: 2px;
    word-spacing: -16px;
}

/* endregion */

/* region ============ Dropdown ============ */

.unity-base-popup-field__arrow {
    margin-right: 5px;
}

/* endregion */

/******************************************************
 ******************** OAB-style UI ********************
 ******************************************************/

/* region ============ OAB-style Button ============ */

.oab-button {
    color: rgb(0, 0, 0);
    border-width: 1px;
    padding: 1px;
    border-radius: 8px;
}

.oab-button,
.oab-button:hover,
.oab-button:active,
.oab-button:focus {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(87, 95, 111);
}

.oab-button > .oab-button__inner {
    flex-grow: 1;
    background-color: rgb(189, 196, 209);
    border-radius: 7px;
    justify-content: center;
}

.oab-button:hover > .oab-button__inner {
    background-color: rgb(214, 224, 255);
}

.oab-button:active > .oab-button__inner {
    background-color: rgb(191, 202, 235);
}

.oab-button > .oab-button__inner > .oab-button__label {
    color: rgb(34, 38, 46);
    -unity-font-definition: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Fonts/SFPixelate/pixelate%20SDF.asset?fileID=11400000&guid=b04efd89de5b82b47829ada6e728086c&type=2#pixelate SDF');
    -unity-font-style: bold;
    height: 100%;
    padding-top: 6px;
    font-size: 16px;
    position: absolute;
    width: 100%;
}

.oab-button.destructive {
    border-color: rgb(209, 173, 173);
}

.oab-button.destructive > .oab-button__inner {
    background-color: rgb(209, 173, 173);
}

.oab-button.destructive:hover {
    border-color: rgb(209, 146, 146);
}

.oab-button.destructive:hover > .oab-button__inner {
    background-color: rgb(209, 146, 146);
}

.oab-button.destructive:active {
    border-color: rgb(209, 119, 119);
}

.oab-button.destructive:active > .oab-button__inner {
    background-color: rgb(209, 119, 119);
}

.oab-button.active {
    border-color: rgb(188, 161, 255);
}

.oab-button.active > .oab-button__inner {
    background-color: rgb(188, 161, 255);
}

.oab-button.active:hover {
    border-color: rgb(206, 190, 255);
}

.oab-button.active:hover > .oab-button__inner {
    background-color: rgb(206, 190, 255);
}

.unity-button.oab-close-button {
    -unity-font-definition: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Fonts/SFPixelate/pixelate%20SDF.asset?fileID=11400000&guid=b04efd89de5b82b47829ada6e728086c&type=2#pixelate SDF');
    width: 24px;
    height: 24px;
    padding: 0;
    margin-right: -4px;
    margin-top: -4px;
    font-size: 20px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(127, 133, 152);
}

.unity-button.oab-close-button:hover {
    color: rgb(120, 21, 18);
}

.unity-button.oab-close-button:active {
    color: rgb(189, 26, 24);
}


/* endregion */

/* region ============ OAB-style TextField ============ */

.oab-text-field > .unity-base-text-field__input,
.oab-text-field:hover > .unity-base-text-field__input,
.oab-text-field:active > .unity-base-text-field__input,
.oab-text-field:focus > .unity-base-text-field__input {
    border-radius: 8px;
    border-width: 1px;
    background-color: rgba(0, 0, 0, 0.113);
    border-color: rgb(81, 89, 103);
    height: 28px;
    color: rgb(165, 171, 184);
    margin: 0;
}

/* endregion */

/* region ============ OAB-style button-like Toggle ============ */

.oab-button-toggle {
    color: rgb(0, 0, 0);
    border-width: 1px;
    padding: 1px;
    border-radius: 8px;
    margin: 0;
}

.oab-button-toggle,
.oab-button-toggle:hover,
.oab-button-toggle:active,
.oab-button-toggle:focus {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(87, 95, 111);
}

.oab-button-toggle > .oab-button-toggle__label {
    color: rgb(34, 38, 46);
    -unity-font-definition: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Fonts/SFPixelate/pixelate%20SDF.asset?fileID=11400000&guid=b04efd89de5b82b47829ada6e728086c&type=2#pixelate SDF');
    -unity-font-style: bold;
    height: 100%;
    padding-top: 6px;
    font-size: 16px;
    position: absolute;
    width: 100%;
    -unity-text-align: middle-center;
}

.oab-button-toggle > .unity-toggle__input {
    flex-grow: 1;
    background-color: rgb(189, 196, 209);
    border-radius: 7px;
    justify-content: center;
    width: 100%;
}

.oab-button-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    visibility: hidden;
}

.oab-button-toggle:hover > .unity-toggle__input {
    background-color: rgb(214, 224, 255);
}

.oab-button-toggle:active > .unity-toggle__input {
    background-color: rgb(191, 202, 235);
}

.oab-button-toggle:checked > .unity-toggle__input {
    background-color: rgb(188, 161, 255);
}

.oab-button-toggle:checked:hover > .unity-toggle__input {
    background-color: rgb(206, 190, 255);
}

.oab-button-toggle > .oab-button-toggle-label {
    color: rgb(34, 38, 46);
    -unity-font-definition: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Fonts/SFPixelate/pixelate%20SDF.asset?fileID=11400000&guid=b04efd89de5b82b47829ada6e728086c&type=2#pixelate SDF');
    -unity-font-style: bold;
    height: 100%;
    padding-top: 6px;
    font-size: 16px;
    position: absolute;
    width: 100%;
    -unity-text-align: middle-center;
}

/* endregion */

/* region ============ Staging stack-like Toggle ============ */

.bar-toggle {
    height: 16px;
    width: initial;
    margin: 0;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.3);
    justify-content: center;
    background-image: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Sprites/ELE-frame-pixel.png?fileID=21300000&guid=07c6d874f871e1c4ba63a23590b015eb&type=3#ELE-frame-pixel');
    transition-duration: 0.3s;
    transition-property: -unity-background-image-tint-color;
}

.bar-toggle-vertical {
    background-image: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Sprites/ELE-frame-pixel.png?fileID=21300000&guid=07c6d874f871e1c4ba63a23590b015eb&type=3#ELE-frame-pixel');
    -unity-slice-scale: 0.5px;
}

.bar-toggle {
    -unity-slice-scale: 0.5px;
}

.bar-toggle.dark {
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.7);
}

.bar-toggle:hover {
    -unity-background-image-tint-color: rgb(0, 204, 81);
}

.bar-toggle:active {
    -unity-background-image-tint-color: rgb(0, 255, 102);
}

.bar-toggle.bar-toggle-vertical {
    flex-direction: column;
    width: 16px;
    height: initial;
}

.bar-toggle > .unity-toggle__input {
    position: absolute;
    top: 2px;
    right: 2px;
    bottom: 2px;
    left: 2px;
    background-image: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Sprites/bracket.png?fileID=2800000&guid=57aeb0876b8ec694e81f46be8cf94188&type=3#bracket');
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    -unity-slice-left: 14;
    -unity-slice-right: 14;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: rgb(170, 178, 204);
}

.bar-toggle:hover > .unity-toggle__input {
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.bar-toggle > .bar-toggle-arrow {
    width: 8px;
    height: 8px;
    margin: 4px;
    background-image: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Sprites/icon-expand-right.png?fileID=21300000&guid=ff1108e4a3c4aeb47b4b319bae07bdd5&type=3#icon-expand-right');
    -unity-background-image-tint-color: rgb(170, 178, 204);
}

.bar-toggle:checked > .bar-toggle-arrow {
    background-image: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Sprites/icon-expand-left.png?fileID=21300000&guid=04691fd6fa6913048b69a2e2144fa29f&type=3#icon-expand-left');
}

.bar-toggle:hover > .bar-toggle-arrow {
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.bar-toggle > .bar-toggle-dot {
    width: 6px;
    height: 6px;
    margin: 5px;
    border-radius: 4px;
    background-color: rgb(114, 138, 231);
}

.bar-toggle:hover > .bar-toggle-dot {
    background-color: rgb(222, 213, 123);
}

.bar-toggle:active > .bar-toggle-dot {
    background-color: rgb(255, 255, 255);
}

.bar-toggle > .bar-toggle-dot.bar-toggle-dot-open {
    display: none;
}

.bar-toggle:checked > .bar-toggle-dot.bar-toggle-dot-open {
    display: flex;
}

.bar-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    display: none;
}

/* endregion */

/* region ============ Flight view appbar panel ============ */

.flight-panel {
    background-color: rgba(0, 0, 0, 0.98);
    border-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 2px;
    border-radius: 6px;
}

.flight-panel > .flight-panel-outer-container {
}

.flight-panel > .flight-panel-outer-container > .flight-panel-inner-container {
    background-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    border-color: rgb(42, 42, 102);
    border-width: 1px;
    justify-content: center;
}

.flight-panel > .flight-panel-outer-container >.flight-panel-label-outer-container {
    background-color: rgba(0, 0, 0, 0);
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 15px;
}

.flight-panel > .flight-panel-outer-container >.flight-panel-label-outer-container > .flight-panel-border-container {
    position: absolute;
    height: 5px;
    bottom: 0;
    overflow: hidden;
    width: 100%;
}

.flight-panel > .flight-panel-outer-container >.flight-panel-label-outer-container > .flight-panel-border-container > .flight-panel-border {
    background-color: rgba(0, 0, 0, 0);
    height: 15px;
    position: absolute;
    width: 100%;
    bottom: 0;
    border-radius: 5px;
    border-color: rgb(83, 86, 204);
    border-width: 1px;
}

.flight-panel > .flight-panel-outer-container >.flight-panel-label-outer-container > .flight-panel-label-inner-container {
    background-color: rgba(0, 0, 0, 0);
    position: absolute;
    width: 100%;
    bottom: -1px;
}

.flight-panel > .flight-panel-outer-container >.flight-panel-label-outer-container > .flight-panel-label-inner-container > .flight-panel-label {
    color: rgb(98, 102, 240);
    font-size: 8.8px;
    padding: 0 4px 0 5px;
    height: 11px;
    align-self: center;
    -unity-font-definition: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Fonts/RosesAreFF0000/RosesareFF0000%20SDF.asset?fileID=11400000&guid=f2516f1635a41814ca97b23fac4691fd&type=2#RosesareFF0000 SDF');
    border-color: rgb(0, 0, 0);
    border-bottom-width: 3px;
    -unity-text-align: upper-right;
    letter-spacing: 16;
}

/* endregion */
